# nginx reverse proxy example for the Swarm live dashboard.
#
# Install:
#   sudo cp dashboard/nginx.conf.example /etc/nginx/conf.d/swarm-dashboard.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Adjust `server_name`, TLS certificates, and the upstream address as needed.

# Log format that records $uri (path only) instead of $request (which includes query string)
# so that ?token= never lands in access logs.
log_format swarm_dashboard_log '$remote_addr - $remote_user [$time_local] '
                               '"$uri" $status $body_bytes_sent '
                               '"$http_referer" "$http_user_agent"';

# Rate limit zone for /api/ endpoints: 30 requests per second per IP, burst of 50.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;

upstream swarm_dashboard {
    # dashboard/server.py (ThreadingHTTPServer)
    server 127.0.0.1:8787;
    keepalive 32;
}

server {
    listen 80;
    server_name _;  # replace with your host name

    access_log /var/log/nginx/swarm-dashboard-access.log swarm_dashboard_log;

    # Basic security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        proxy_pass http://swarm_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE / long-polling friendly: disable response buffering so
        # text/event-stream (GET /api/events) flows to the client immediately.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_connect_timeout 60s;

        # X-Accel-Buffering: no disables buffering in nginx and any
        # intermediate proxy for streaming responses.
        proxy_set_header X-Accel-Buffering no;
    }

    # Rate limit for API endpoints
    location /api/ {
        limit_req zone=api_limit burst=50 nodelay;
        limit_req_status 429;

        proxy_pass http://swarm_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_connect_timeout 60s;
        proxy_set_header X-Accel-Buffering no;
    }
}

# To enable TLS, add a second server block (example):
#
# server {
#     listen 443 ssl http2;
#     server_name your.host.name;
#
#     ssl_certificate     /etc/letsencrypt/live/your.host.name/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your.host.name/privkey.pem;
#
#     # HSTS: tell browsers to only use HTTPS for this host for 1 year
#     add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
